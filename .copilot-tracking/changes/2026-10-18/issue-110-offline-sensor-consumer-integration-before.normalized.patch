+@dataclass(frozen=True)
+class ExercisePolicy:
+    window_start: str
+    window_end: str
+    max_past_seconds: int
+    max_future_seconds: int
+    temperature_min: float
+    temperature_max: float
+    humidity_min: float
+    humidity_max: float
