+def utc(value: str) -> datetime:
+    if not isinstance(value, str) or not STAMP.fullmatch(value):
+        raise ValueError("UTC_SECONDS_REQUIRED")
+    return datetime.fromisoformat(value.replace("Z", "+00:00"))
