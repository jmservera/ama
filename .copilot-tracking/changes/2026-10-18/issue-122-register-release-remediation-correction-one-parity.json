      "diff": "diff --git a/src/api/README.md b/src/api/README.md\nindex ce89133a..cf401f62 100644\n--- a/src/api/README.md\n+++ b/src/api/README.md\n@@ -87,7 +87,12 @@ releases with no proposal reference. Missing, truncated, malformed or contradict\n records make production incomplete and offline verification invalid, even after\n the ordinary bundle digest is recomputed. Lifecycle checks allow repeated\n suspension and timestamp ties supported by the writer, but cannot authenticate\n-wholesale consistent rewriting of unanchored history. Known-empty SQL evidence\n+wholesale consistent rewriting of unanchored history. Event timestamps accept\n+only integers and floats that pass floating-point finiteness validation, excluding\n+booleans; conversion overflow, nonfinite values and nonnumeric values explicitly\n+make producer evidence incomplete and offline verification invalid. This is not\n+a calendar-date policy; finite negative, fractional and large numeric values\n+retain their existing meaning. Known-empty SQL evidence\n and explicit unsupported JSON storage remain distinct from unavailable evidence.\n Audience-limited exports remain explicitly incomplete, never full ledger proof;\n externally held canonical heads are unchanged. Local synthetic proof is not\n"
    },
    "src/api/tests/test_continuity_epoch_export.py": {
      "before_sha256": "3e0e753a03c88855260f515bce2e0f26a5203b9e77aa77f0f068c48057849956",
      "after_sha256": "8d0734c32d393a010626cd008ea0e65e09429fcd94d7b5067d969c830906738b",
      "diff": "diff --git a/src/api/tests/test_continuity_epoch_export.py b/src/api/tests/test_continuity_epoch_export.py\nindex 60706e0e..29052be2 100644\n--- a/src/api/tests/test_continuity_epoch_export.py\n+++ b/src/api/tests/test_continuity_epoch_export.py\n@@ -821,6 +821,68 @@ class OfflineTests(Base):\n             self.assertFalse(produced[\"complete\"])\n             self.assertFalse(self.redigest(produced)[\"valid\"])\n \n+    def test_json_numeric_timestamps_fail_closed_without_conversion_errors(self) -> None:\n+        part = self.service.export()\n+        original = self.store.continuity_export(self.pm, part)\n+        head = copy.deepcopy(original[\"ledger\"][\"head\"])\n+        self.assertTrue(continuity.verify_export(original, head)[\"valid\"])\n+        cases = (\n+            (0, True),\n+            (-1, True),\n+            (1.25, True),\n+            (-1.25, True),\n+            (10**308, True),\n+            (-(10**308), True),\n+            (1.7976931348623157e308, True),\n+            (-1.7976931348623157e308, True),\n+            (10**400, False),\n+            (-(10**400), False),\n+            (True, False),\n+            (False, False),\n+            (None, False),\n+            (\"2000000000\", False),\n+            (float(\"nan\"), False),\n+            (float(\"inf\"), False),\n+            (-float(\"inf\"), False),\n+        )\n+        problem = \"invalid task-release event envelope\"\n+        for boundary in (\"producer\", \"verifier\"):\n+            for at, valid in cases:\n+                with self.subTest(boundary=boundary, at=at):\n+                    source = copy.deepcopy(part if boundary == \"producer\" else original)\n+                    source[\"task_releases\"][\"records\"][0][\"events\"][0][\"at\"] = at\n+                    source = json.loads(json.dumps(source))\n+                    if boundary == \"producer\":\n+                        bundle = self.store.continuity_export(self.pm, source)\n+                        expected_head = copy.deepcopy(bundle[\"ledger\"][\"head\"])\n+                        self.assertEqual(bundle[\"complete\"], valid, bundle[\"incomplete_reasons\"])\n+                        if not valid:\n+                            self.assertIn(problem, bundle[\"incomplete_reasons\"])\n+                    else:\n+                        bundle = source\n+                        expected_head = head\n+                        bundle[\"complete\"] = True\n+                        bundle[\"incomplete_reasons\"] = []\n+                        bundle[\"digest\"] = continuity.sha(\n+                            {k: v for k, v in bundle.items() if k != \"digest\"}\n+                        )\n+                    bundle = json.loads(json.dumps(bundle))\n+                    check = continuity.verify_export(bundle, expected_head)\n+                    self.assertEqual(check[\"valid\"], valid, check)\n+                    self.assertEqual(check[\"complete\"], valid, check)\n+                    if boundary == \"verifier\":\n+                        self.assertEqual(bundle[\"ledger\"], original[\"ledger\"])\n+                    self.assertEqual(bundle[\"ledger\"][\"head\"], expected_head)\n+                    self.assertFalse(\n+                        any(\n+                            \"digest mismatch\" in p or \"externally held\" in p\n+                            for p in check[\"problems\"]\n+                        ),\n+                        check,\n+                    )\n+                    if not valid:\n+                        self.assertIn(problem, check[\"problems\"])\n+\n     def test_release_source_absence_and_unsupported_are_not_full_evidence(self) -> None:\n         part = self.service.export()\n         missing = copy.deepcopy(part)\n"
    },
