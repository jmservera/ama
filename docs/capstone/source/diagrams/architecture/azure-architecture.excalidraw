      "infrastructure": {
        "path": "infra/main.bicep",
        "line": 70,
        "anchor": "@description('Enable direct model calls from the existing MVP API. Leave false for the proposed separate agent-runner topology; true grants the API model invocation rights and configures AI_ENDPOINT.')",
