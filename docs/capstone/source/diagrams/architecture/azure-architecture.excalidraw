        "classification": "Foundry account/project/deployments; direct API inference conditional; GlobalStandard is not UK processing proof"
      },
      "deviceTransport": {
        "path": "infra/modules/iothub.bicep",
        "line": 50,
        "anchor": "resource telemetryNamespace 'Microsoft.EventHub/namespaces@2024-01-01' = {",
