    {
      "id": "148802958c3428e310dd",
      "type": "text",
      "x": 74,
      "y": 2730,
      "width": 2680,
      "height": 86.25,
      "angle": 0,
      "strokeColor": "#50635d",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 179677847,
      "version": 1,
      "versionNonce": 111992275,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791972000000,
      "link": null,
      "locked": false,
      "text": "Five-assistant inference never holds database locks and never approves domain changes. Responses are implicit unless double-headed.\nBlue arrows are configured relationships, not proof of end-to-end telemetry or private-only access. Deferred boxes are not working code.\nEmail / Teams alerts do not replace owned safety response. Historical Decision 1 evaluation is not a current API runtime dependency.",
      "originalText": "Five-assistant inference never holds database locks and never approves domain changes. Responses are implicit unless double-headed.\nBlue arrows are configured relationships, not proof of end-to-end telemetry or private-only access. Deferred boxes are not working code.\nEmail / Teams alerts do not replace owned safety response. Historical Decision 1 evaluation is not a current API runtime dependency.",
      "fontSize": 23,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
