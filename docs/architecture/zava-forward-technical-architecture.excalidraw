    {
      "id": "916097e2fd2e181eb6d1",
      "type": "text",
      "x": 96,
      "y": 1690,
      "width": 392,
      "height": 225.0,
      "angle": 0,
      "strokeColor": "#50635d",
      "backgroundColor": "transparent",
