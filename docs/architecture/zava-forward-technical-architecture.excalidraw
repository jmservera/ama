      "seed": 46292229,
      "version": 1,
      "versionNonce": 216704140,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791972000000,
      "link": null,
      "locked": false,
      "text": "VNet default: 10.40.0.0/16\nsnet-aca: 10.40.0.0/23\nsnet-pe: 10.40.4.0/24\nPrivate endpoints + DNS + NSGs\nSQL / Blob / Queue / KV / ACR\nFoundry / Monitor (AMPLS)\nDev also permits public access.\nNo private-only production claim.\nPaaS boxes are NOT VNet-hosted.",
      "originalText": "VNet default: 10.40.0.0/16\nsnet-aca: 10.40.0.0/23\nsnet-pe: 10.40.4.0/24\nPrivate endpoints + DNS + NSGs\nSQL / Blob / Queue / KV / ACR\nFoundry / Monitor (AMPLS)\nDev also permits public access.\nNo private-only production claim.\nPaaS boxes are NOT VNet-hosted.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
