  "exerciseExceptions": [
    {
      "id": "NP-EX-001",
      "storeCategory": "Storage / Key Vault / ACR / AI Services / IoT Hub",
      "bicepPath": "infra/main.bicep",
      "resourceType": "parameter:allowPublicNetworkAccess",
      "owner": "Juan Manuel Servera (@jmservera)",
      "policyExceptionRef": "EX-001 (infra/policy-exceptions.json)",
      "rationale": "Development-profile operator opt-in parameter (default false across all committed main*.bicepparam files) preserved for bounded synthetic development troubleshooting when no private jumpbox is active.",
      "compensatingControls": [
        "Defaults to false in infra/main.bicep and all three infra/main*.bicepparam files",
        "Blocked mechanically by infra/modules/guard.bicep when deploymentProfile == 'production', environmentName == 'pilot', or demoDirectIngress == true",
        "Never applies to Azure SQL (infra/modules/sql.bicep) or telemetry Event Hub (infra/modules/iothub.bicep), which disable publicNetworkAccess unconditionally",
        "Local/shared-key auth remains disabled (RBAC/Entra-only)"
      ]
    },
    {
      "id": "NP-EX-002",
      "storeCategory": "AI Services (Standalone Resident Prototype)",
      "bicepPath": "infra/resident-assistant.bicep",
      "resourceType": "Microsoft.CognitiveServices/accounts",
      "owner": "Juan Manuel Servera (@jmservera)",
      "policyExceptionRef": "docs/architecture/resident-assistant-prototype.md",
      "rationale": "Standalone opt-in (enabled = false by default) Sweden Central Azure OpenAI S0 account (aoai-resident-469) explicitly outside the core UK South private staff boundary for synthetic resident showcase testing only.",
      "compensatingControls": [
        "Disabled by default (param enabled bool = false) and excluded from infra/main.bicep",
        "disableLocalAuth: true with Cognitive Services OpenAI User RBAC restricted to showcase managed identity",
        "Hard SQL-enforced lifetime USD20 reservation ledger and synthetic-only resident data boundary"
      ]
    },
    {
      "id": "NP-EX-003",
      "storeCategory": "IoT Hub (Standalone Child Reconciliation)",
      "bicepPath": "infra/iot-hub-live.bicep",
      "resourceType": "Microsoft.Devices/IotHubs",
      "owner": "Juan Manuel Servera (@jmservera)",
      "policyExceptionRef": "infra/README.md#live-iot-hub-child-reconciliation",
      "rationale": "Additive child-resource template attaching consumer group api-consumer and metrics-only diagnostic settings to existing exercise hub iot-cutover-test-rzsrg without re-issuing a hub PUT or altering its existing private endpoint.",
      "compensatingControls": [
        "Guarded by infra/modules/iothub-scope-guard.bicep to resource group ama and hub prefix iot-",
        "Verified publicNetworkAccess: Disabled and disableLocalAuth: true on existing exercise hub"
      ]
    },
    {
      "id": "NP-EX-004",
      "storeCategory": "Storage (ACA Environment Certificate Share)",
      "bicepPath": "infra/live-simulator-job.bicep",
      "relatedBicepPaths": [
        "infra/live-receiver-job.bicep"
      ],
      "resourceType": "Microsoft.App/managedEnvironments/storages (AzureFile mount)",
      "owner": "Juan Manuel Servera (@jmservera)",
      "policyExceptionRef": "infra/README.md",
      "rationale": "Undeployed standalone synthetic telemetry jobs mount an operator-staged Container Apps environment AzureFile share (certStorageName) read-only for synthetic X.509 device certificates (<device>.pem, <device>.key, control.json) inside the existing internal ACA VNet environment.",
      "compensatingControls": [
        "Mounted strictly read-only (mountOptions: 'ro') inside existing internal VNet-integrated Container Apps environment",
        "Holds synthetic exercise device certificates only, never staff or production credentials"
      ]
    },
    {
      "id": "NP-EX-005",
      "storeCategory": "SQL / Key Vault / ACR (Standalone Resident Showcase)",
      "bicepPath": "infra/resident-demo.bicep",
      "resourceType": "Microsoft.App/containerApps (external showcase dependencies)",
      "owner": "Juan Manuel Servera (@jmservera)",
      "policyExceptionRef": "docs/architecture/README.md",
      "rationale": "Standalone resident showcase Container App consumes pre-provisioned private ACA environment, existing private Key Vault, existing private ACR, and independently supplied showcase SQL server FQDN rather than re-provisioning private endpoints.",
      "compensatingControls": [
        "Enforces ZF_SQL_AUTH = 'msi' (managed identity only, zero SQL passwords)",
        "Reads demo-password-verifier and demo-session-key exclusively from Key Vault via user-assigned managed identity"
      ]
    },
    {
      "id": "NP-EX-006",
      "storeCategory": "Volatile Simulation Store (EmptyDir SQLite)",
      "bicepPath": "infra/modules/containerapps.bicep",
      "resourceType": "EmptyDir:/state/public-simulation/store.sqlite",
      "owner": "Juan Manuel Servera (@jmservera)",
      "policyExceptionRef": "infra/main.bicep (enablePublicSimulationLane)",
      "rationale": "Opt-in public simulation lane (enablePublicSimulationLane = false by default) writes synthetic exercise state to a single-replica volatile EmptyDir scratch volume rather than Azure SQL.",
      "compensatingControls": [
        "Off by default (enablePublicSimulationLane = false) and blocked by parameter-guard unless demoDirectIngress is enabled with max 1 API replica",
        "Explicitly non-durable, isolated from staff Azure SQL data, and wiped on replica restart"
      ]
    },
    {
      "id": "NP-EX-007",
      "storeCategory": "External Document SaaS (Proposed SharePoint)",
      "bicepPath": "infra/main.bicep",
      "resourceType": "parameter:evidenceStore=sharepoint",
      "owner": "Juan Manuel Servera (@jmservera)",
      "policyExceptionRef": "docs/architecture/README.md#state-trade-offs-and-known-limits",
      "rationale": "Microsoft 365 SharePoint Online is a Microsoft Graph SaaS service (Sites.Selected) without customer VNet private-link endpoints, and remains an unimplemented topology parameter (default evidenceStore is private 'blob').",
      "compensatingControls": [
        "Default evidenceStore is 'blob' backed by pe-${name}-blob in snet-pe",
        "Architecture documentation explicitly marks SharePoint adapter unimplemented"
      ]
    }
  ],
