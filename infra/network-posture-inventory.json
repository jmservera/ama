      "containerSecretNameParam": null,
      "keyVaultSecretName": "entra-token-store-sas",
      "keyVaultUrlPattern": "${keyVaultUri}/secrets/entra-token-store-sas",
      "managedIdentityRef": "identityIds.api",
      "conditionalOn": "enableEntraTokenStore",
      "consumers": [
        "env:AUTH_TOKEN_STORE_ROTATION.secretRef",
        "authConfigs.login.tokenStore.azureBlobStorage.sasUrlSettingName"
      ]
    },
    {
      "containerAppBicepPath": "infra/resident-demo.bicep",
