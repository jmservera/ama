        "defaultCidr": "10.40.0.0/23",
        "nsgNameExpression": "nsg-${prefix}-aca",
        "delegation": "Microsoft.App/environments",
        "privateEndpointNetworkPolicies": null,
        "conditionalOn": null,
        "purpose": "Primary internal Azure Container Apps workload-profile environment subnet"
      },
      {
        "id": "snet-pe",
        "name": "snet-pe",
        "bicepPath": "infra/modules/network.bicep",
        "defaultCidr": "10.40.4.0/24",
        "nsgNameExpression": "nsg-${prefix}-pe",
        "delegation": null,
        "privateEndpointNetworkPolicies": "Enabled",
        "conditionalOn": null,
        "purpose": "Dedicated private-endpoint subnet hosting all core data-store and AMPLS NICs (inbound TCP 443 and 1433 from VirtualNetwork; deny-all fallback)"
      },
      {
        "id": "snet-aca-demo",
        "name": "snet-aca-demo",
        "bicepPath": "infra/modules/network.bicep",
        "defaultCidr": "10.40.6.0/23",
        "nsgNameExpression": "nsg-${prefix}-aca-demo",
        "delegation": "Microsoft.App/environments",
        "privateEndpointNetworkPolicies": null,
        "conditionalOn": "demoDirectIngress",
